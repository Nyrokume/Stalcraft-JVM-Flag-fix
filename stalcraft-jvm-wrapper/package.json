{
  "name": "stalcraft-jvm-wrapper",
  "version": "1.6.1",
  "description": "STALZONE JVM Wrapper — Tauri desktop IFEO JVM tuning",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:web": "vite",
    "dev:tauri": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "vite": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "build:prod": "powershell -ExecutionPolicy Bypass -File scripts/package.ps1",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "test:ui": "vite build --mode test && node scripts/ui-smoke.mjs",
    "test:sb": "node scripts/server-blocker.test.mjs",
    "test:rust": "cd src-tauri && cargo test --lib",
    "test": "npm run test:sb && npm run test:rust && npm run test:ui"
  },
  "keywords": [
    "stalcraft",
    "jvm",
    "optimization",
    "tauri"
  ],
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "playwright": "^1.61.1",
    "vite": "^8.0.3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.2.1"
  }
}
